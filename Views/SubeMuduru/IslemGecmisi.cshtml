@model List<WebBank.Models.Islem>

@{
    ViewData["Title"] = "İşlem Geçmişi";
}

<h2>Şube İşlem Geçmişi</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>İşlem Türü</th>
            <th>Miktar</th>
            <th>Ücret</th>
            <th>Açıklama</th>
            <th>Hesap IBAN</th>
            <th>Gişe Memuru</th>
            <th>İnternet Üzerinden Mi?</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center">Bu şubeye ait işlem bulunamadı.</td>
            </tr>
        }
        else
        {
            foreach (var islem in Model)
            {
                <tr>
                    <td>@islem.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@islem.Tur.ToString()</td>
                    <td>@islem.Miktar.ToString("C")</td>
                    <td>@islem.Ucret.ToString("C")</td>
                    <td>@islem.Aciklama</td>
                    <td>@islem.Hesap.IBAN</td>
                    <td>@(islem.GiseMemuru != null ? $"{islem.GiseMemuru.Ad} {islem.GiseMemuru.Soyad}" : "-")</td>
                    <td>@(islem.InternetUzerindenMi ? "Evet" : "Hayır")</td>
                </tr>
            }
        }
    </tbody>
</table>
