@model WebBank.Models.ViewModels.EftViewModel

<h2>EFT İşlemi</h2>

<form asp-action="Eft" method="post">
    <div class="form-group">
        <label>Alıcı IBAN</label>
        <input asp-for="AliciIban" class="form-control" />
        <span asp-validation-for="AliciIban" class="text-danger"></span>
    </div>

    <div class="form-group" id="bankaAdiGroup">
        <label>Alıcı Banka Adı</label>
        <input asp-for="AliciBankaAdi" class="form-control" />
        <span asp-validation-for="AliciBankaAdi" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Gönderen Hesap</label>
        <<select asp-for="GonderenHesapId" class="form-control" asp-items="ViewBag.HesapSecenekleri">

            <option value="">-- Hesap Seçin --</option>
        </select>
        <span asp-validation-for="GonderenHesapId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Tutar</label>
        <input asp-for="Tutar" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Tutar" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Açıklama (isteğe bağlı)</label>
        <input asp-for="Aciklama" class="form-control" />
        <span asp-validation-for="Aciklama" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">EFT Yap</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
