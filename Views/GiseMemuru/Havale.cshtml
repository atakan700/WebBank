@model WebBank.Models.ViewModels.HavaleViewModel

@{
    ViewData["Title"] = "Gişe Memuru Havale İşlemi";
}

<h2>Gişe Memuru Havale İşlemi</h2>



<form asp-action="Havale" method="post" novalidate>
    <div class="form-group">
        <label>Gönderen Hesap (Şube hesapları)</label>
        <select asp-for="GonderenHesapId" class="form-control" asp-items="@(new SelectList(Model.KullaniciHesaplari, "Id", "IBAN"))">
            <option value="">Hesap Seçiniz</option>
        </select>
        <span asp-validation-for="GonderenHesapId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Alıcı IBAN</label>
        <input asp-for="AliciIban" class="form-control" />
        <span asp-validation-for="AliciIban" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Tutar</label>
        <input asp-for="Tutar" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Tutar" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Transfer Et</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
